generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  WALLET
  UPI
  INVESTMENT
  OTHER
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum BudgetDuration {
  MONTHLY
  CUSTOM
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  ARCHIVED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash")
  currency     String    @default("INR") @db.Char(3)
  timezone     String    @default("Asia/Kolkata") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  savingsContributions  SavingsGoalContribution[]
  debts                 Debt[]
  debtPayments          DebtPayment[]

  @@map("users")
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String      @db.VarChar(120)
  type           AccountType
  institution    String?     @db.VarChar(160)
  currency       String      @default("INR") @db.Char(3)
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(14, 2)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, isActive])
  @@index([userId, name])
  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  name      String       @db.VarChar(100)
  type      CategoryType
  parentId  String?      @map("parent_id") @db.Uuid
  isSystem  Boolean      @default(false) @map("is_system")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId, type, isActive])
  @@index([parentId])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  description     String          @db.VarChar(255)
  transactionDate DateTime        @map("transaction_date") @db.Date
  notes           String?
  transferGroupId String?         @map("transfer_group_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  debtPayment DebtPayment?

  @@index([userId, transactionDate(sort: Desc)])
  @@index([userId, type, transactionDate(sort: Desc)])
  @@index([userId, categoryId, transactionDate(sort: Desc)])
  @@index([accountId, transactionDate(sort: Desc)])
  @@index([transferGroupId])
  @@map("transactions")
}

model Budget {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  categoryId    String         @map("category_id") @db.Uuid
  month         DateTime       @db.Date
  amount        Decimal        @db.Decimal(14, 2)
  alertPercent  Decimal        @default(80) @map("alert_percent") @db.Decimal(5, 2)
  duration      BudgetDuration
  startDate     DateTime?      @map("start_date") @db.Date
  endDate       DateTime?      @map("end_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  adjustments BudgetAdjustment[]

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

model BudgetAdjustment {
  id                String   @id @default(uuid()) @db.Uuid
  budgetId          String   @map("budget_id") @db.Uuid
  oldAmount         Decimal  @map("old_amount") @db.Decimal(14, 2)
  newAmount         Decimal  @map("new_amount") @db.Decimal(14, 2)
  oldAlertPercent   Decimal? @map("old_alert_percent") @db.Decimal(5, 2)
  newAlertPercent   Decimal? @map("new_alert_percent") @db.Decimal(5, 2)
  reason            String   @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at")

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, createdAt])
  @@map("budget_adjustments")
}

model SavingsGoal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(120)
  targetAmount Decimal  @map("target_amount") @db.Decimal(14, 2)
  targetDate  DateTime? @map("target_date") @db.Date
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsGoalContribution[]

  @@index([userId, isActive])
  @@index([userId, targetDate])
  @@map("savings_goals")
}

model SavingsGoalContribution {
  id             String   @id @default(uuid()) @db.Uuid
  goalId         String   @map("goal_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  amount         Decimal  @db.Decimal(14, 2)
  contributionDate DateTime @map("contribution_date") @db.Date
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @db.Date

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, goalId, contributionDate(sort: Desc)])
  @@index([goalId, createdAt(sort: Desc)])
  @@map("savings_goal_contributions")
}

model Debt {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  name              String     @db.VarChar(120)
  principalAmount   Decimal    @map("principal_amount") @db.Decimal(14, 2)
  outstandingAmount Decimal    @map("outstanding_amount") @db.Decimal(14, 2)
  interestRate      Decimal    @default(0) @map("interest_rate") @db.Decimal(7, 4)
  minimumPayment    Decimal?   @map("minimum_payment") @db.Decimal(14, 2)
  dueDay            Int?       @map("due_day")
  status            DebtStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, status])
  @@index([userId, dueDay])
  @@map("debts")
}

model DebtPayment {
  id            String      @id @default(uuid()) @db.Uuid
  debtId        String      @map("debt_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  transactionId String      @unique @map("transaction_id") @db.Uuid
  amount        Decimal     @db.Decimal(14, 2)
  paymentDate   DateTime    @map("payment_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")

  debt        Debt        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, debtId, paymentDate(sort: Desc)])
  @@index([debtId, createdAt(sort: Desc)])
  @@map("debt_payments")
}
